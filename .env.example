# Required for real food-photo analysis. Never expose this in NEXT_PUBLIC_*.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# Set this on an external API deployment when the frontend is on GitHub Pages.
ALLOWED_ORIGIN=https://nahin333.github.io

# Build-time frontend configuration for a separate API host.
NEXT_PUBLIC_API_BASE_URL=

# Optional future retailer adapter credentials.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
